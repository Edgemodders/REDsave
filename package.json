{
  "name": "redsave",
  "displayName": "REDsave",
  "description": "Save game manager for Cyberpunk 2077: search and filter your saves, keep sets of them outside the game and swap them in, and give saves your own titles.",
  "version": "0.0.8",
  "publisher": "edgemodders",
  "preview": true,
  "pricing": "Free",
  "license": "MIT",
  "icon": "docs/assets/brand/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/REDsave"
  },
  "homepage": "https://edgemodders.github.io/REDsave/",
  "bugs": {
    "url": "https://github.com/Edgemodders/REDsave/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "cyberpunk 2077",
    "saves",
    "save games",
    "save manager",
    "modding",
    "redsave"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "redsave",
          "title": "REDsave",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "redsave": [
        {
          "id": "redsave.saves",
          "name": "Saves"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "redsave.saves",
        "contents": "The game's save folder was not found.\nREDsave looks in Saved Games\\CD Projekt Red\\Cyberpunk 2077 in your user folder. Set another one in the settings.\n[Open Settings](command:workbench.action.openSettings?%22redsave.savesPath%22)"
      }
    ],
    "commands": [
      {
        "command": "redsave.openPage",
        "title": "Open the Saves Page",
        "category": "REDsave",
        "icon": "$(search)"
      },
      {
        "command": "redsave.refresh",
        "title": "Refresh",
        "category": "REDsave",
        "icon": "$(refresh)"
      },
      {
        "command": "redsave.openSavesFolder",
        "title": "Open the Game's Save Folder",
        "category": "REDsave",
        "icon": "$(folder-opened)"
      },
      {
        "command": "redsave.newLoadout",
        "title": "New Loadout...",
        "category": "REDsave",
        "icon": "$(add)"
      },
      {
        "command": "redsave.openLoadout",
        "title": "Open Loadout",
        "category": "REDsave"
      },
      {
        "command": "redsave.renameLoadout",
        "title": "Rename...",
        "category": "REDsave"
      },
      {
        "command": "redsave.loadoutNotes",
        "title": "Notes...",
        "category": "REDsave"
      },
      {
        "command": "redsave.openLoadoutFolder",
        "title": "Open Its Folder",
        "category": "REDsave"
      },
      {
        "command": "redsave.removeLoadout",
        "title": "Remove...",
        "category": "REDsave"
      },
      {
        "command": "redsave.undoMove",
        "title": "Undo the Last Move",
        "category": "REDsave",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "redsave.openPage",
          "when": "view == redsave.saves",
          "group": "navigation@0"
        },
        {
          "command": "redsave.refresh",
          "when": "view == redsave.saves",
          "group": "navigation@1"
        },
        {
          "command": "redsave.openSavesFolder",
          "when": "view == redsave.saves",
          "group": "navigation@2"
        },
        {
          "command": "redsave.newLoadout",
          "when": "view == redsave.saves",
          "group": "loadouts@1"
        },
        {
          "command": "redsave.undoMove",
          "when": "view == redsave.saves",
          "group": "loadouts@2"
        }
      ],
      "commandPalette": [
        {
          "command": "redsave.openLoadout",
          "when": "false"
        },
        {
          "command": "redsave.renameLoadout",
          "when": "false"
        },
        {
          "command": "redsave.loadoutNotes",
          "when": "false"
        },
        {
          "command": "redsave.openLoadoutFolder",
          "when": "false"
        },
        {
          "command": "redsave.removeLoadout",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "redsave.newLoadout",
          "when": "view == redsave.saves && viewItem =~ /^redsave.loadouts/",
          "group": "inline"
        },
        {
          "command": "redsave.newLoadout",
          "when": "view == redsave.saves && viewItem =~ /^redsave.loadouts/",
          "group": "loadouts@1"
        },
        {
          "command": "redsave.undoMove",
          "when": "view == redsave.saves && viewItem == redsave.loadouts.undo",
          "group": "loadouts@2"
        },
        {
          "command": "redsave.openLoadout",
          "when": "view == redsave.saves && viewItem == redsave.loadout",
          "group": "loadout@1"
        },
        {
          "command": "redsave.renameLoadout",
          "when": "view == redsave.saves && viewItem == redsave.loadout",
          "group": "loadout@2"
        },
        {
          "command": "redsave.loadoutNotes",
          "when": "view == redsave.saves && viewItem == redsave.loadout",
          "group": "loadout@3"
        },
        {
          "command": "redsave.openLoadoutFolder",
          "when": "view == redsave.saves && viewItem == redsave.loadout",
          "group": "loadout@4"
        },
        {
          "command": "redsave.removeLoadout",
          "when": "view == redsave.saves && viewItem == redsave.loadout",
          "group": "loadout@9"
        }
      ]
    },
    "configuration": {
      "title": "REDsave",
      "properties": {
        "redsave.savesPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The game's save folder. Empty: `Saved Games\\CD Projekt Red\\Cyberpunk 2077` in your user folder, where Steam, GOG and Epic copies of the game all save."
        },
        "redsave.libraryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where REDsave keeps loadouts, outside the game's save folder. Empty: `Saved GamesREDsave` in your user folder, on the same drive as the game's saves, so a move is a rename that happens at once. On another drive, moves copy the saves, check the copies, then remove the originals."
        },
        "redsave.gamePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Cyberpunk 2077 folder, where REDbridge reads quest and place names. Empty: EDGEdeck's when it runs, else found through Steam, GOG or Epic."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "test": "node esbuild.mjs --tests && node --test \"dist-test/*.test.cjs\"",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --readme-path README.marketplace.md",
    "nexus-zip": "node tools/nexus-zip.mjs",
    "nexus:pull": "node tools/nexus/nexus.mjs pull",
    "nexus:status": "node tools/nexus/nexus.mjs status",
    "release:notes": "node tools/release-notes.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "~5.9.3"
  }
}
